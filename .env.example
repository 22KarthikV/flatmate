# Copy to .env.local and fill in. Never commit .env.local.
# Empty values count as unset. Variables are checked by src/lib/env.ts and src/lib/supabase/config.ts.

# debug | info | warn | error (default: info)
LOG_LEVEL=info

# Supabase. Local development: run `pnpm db:start`, which prints the URL and the publishable key.
# Hosted: Project Settings > API. Only the PUBLISHABLE key belongs here. Never put a
# service-role or secret key in a NEXT_PUBLIC_ variable or in browser code.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Route guard: signed-out visitors are sent to /sign-in. It is on unless this is "off"
# (only ever useful for debugging; leave it unset).
AUTH_GUARD=

# Optional public contact address shown on the privacy and terms pages. When empty the
# public issue tracker is shown instead.
NEXT_PUBLIC_CONTACT_EMAIL=

# Push notifications: the PUBLIC half of the VAPID key pair (safe to publish; browsers need it to
# subscribe). Make a pair with `pnpm vapid:generate`. The PRIVATE half goes in Supabase secrets
# only (see docs/DEPLOY.md) and must never be in this file or in any NEXT_PUBLIC_ variable.
# Leave empty and push is simply not offered; the in-app inbox works regardless.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
