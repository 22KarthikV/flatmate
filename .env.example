# Copy to .env.local and fill in. Never commit .env.local.
# All variables are validated at startup by src/lib/env.ts. Empty values count as unset.

# debug | info | warn | error (default: info)
LOG_LEVEL=info

# Supabase (required from the Supabase wiring task onwards)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
