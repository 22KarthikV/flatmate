# Copy to .env.local and fill in. Never commit .env.local.
# Empty values count as unset. Variables are checked by src/lib/env.ts and src/lib/supabase/config.ts.

# debug | info | warn | error (default: info)
LOG_LEVEL=info

# Supabase. Local development: run `pnpm db:start`, which prints the URL and the publishable key.
# Hosted: Project Settings > API. Only the PUBLISHABLE key belongs here. Never put a
# service-role or secret key in a NEXT_PUBLIC_ variable or in browser code.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Route guard. Set to "on" to send signed-out visitors to /sign-in. Off until identity Task 8.
AUTH_GUARD=
