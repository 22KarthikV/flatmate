{
  "ci": {
    "collect": {
      "startServerCommand": "pnpm exec next start -p 3200",
      "startServerReadyPattern": "Ready",
      "startServerReadyTimeout": 60000,
      "url": ["http://localhost:3200/dashboard", "http://localhost:3200/more/flat"],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "warn",
          {
            "minScore": 0.9
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/app"
    }
  }
}
