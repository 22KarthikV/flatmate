// Copies the pure rota scheduler into supabase/functions/_shared/rota so the rota-generate Edge
// Function runs exactly the code the app and its tests do. Deno wants explicit .ts extensions on
// relative imports; the app does not, so the copy rewrites them. A test (edge-copy.test.ts) fails
// when the copy is stale. Run: node scripts/sync-rota-edge.mts

import { mkdirSync, readFileSync, writeFileSync } from "node:fs";
import path from "node:path";

export const SHARED_FILES = ["week", "explain", "fairness", "schedule", "generation"] as const;

const HEADER =
  "// GENERATED by scripts/sync-rota-edge.mts from src/features/rota. Do not edit by hand.\n\n";

/** The Edge copy of a source file: relative imports get a .ts extension. */
export function toEdgeSource(source: string): string {
  return (
    HEADER +
    source.replace(/(from\s+")(\.\/[a-z-]+)(")/g, (_match, a, file, c) => `${a}${file}.ts${c}`)
  );
}

export function edgePath(root: string, name: string): string {
  return path.join(root, "supabase", "functions", "_shared", "rota", `${name}.ts`);
}

export function sourcePath(root: string, name: string): string {
  return path.join(root, "src", "features", "rota", `${name}.ts`);
}

function main(): void {
  const root = process.cwd();
  mkdirSync(path.dirname(edgePath(root, "week")), { recursive: true });
  for (const name of SHARED_FILES) {
    writeFileSync(edgePath(root, name), toEdgeSource(readFileSync(sourcePath(root, name), "utf8")));
  }
  console.log(`Copied ${SHARED_FILES.length} files to supabase/functions/_shared/rota`);
}

if (process.argv[1]?.endsWith("sync-rota-edge.mts")) {
  main();
}
